# Core
PORT=3000
APP_NAME=OfferGrid
SITE_BASE_URL=http://localhost:3000

# Freeze heavyweight background catalog jobs while paid campaign traffic is live.
# Interactive searches still work and click/visit ledgers stay append-only.
CAMPAIGN_TRAFFIC_MODE=false
ATTRIBUTION_COOKIE_DAYS=90
MARKETING_SESSION_MINUTES=30
MARKETING_EVENT_LOG_LIMIT=100000
COMMISSION_EVENT_LOG_LIMIT=100000

# Privacy-safe Admin visitor map. Cloudflare's Add visitor location headers
# Managed Transform must be enabled; OfferGrid never stores the source IP.
VISITOR_GEOLOCATION_ENABLED=true
VISITOR_GEOLOCATION_RETENTION_DAYS=30
VISITOR_ACTIVITY_EVENT_LIMIT=200000

# Admin
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-this-with-a-long-random-string
COOKIE_SECURE=false

# Automatic discovery
AUTO_SYNC_ENABLED=true
AUTO_SYNC_MINUTES=20

# V2.8 autonomous catalog growth
CATALOG_TARGET_PRODUCTS=10000
DISCOVERY_RULES_PER_CYCLE=24
DISCOVERY_RESULTS_PER_RULE=50
DISCOVERY_MAX_RULES=300
DISCOVERY_EXPANSIONS_PER_STALLED_RULE=2
DISCOVERY_MAX_GENERATION_DEPTH=5

# eBay same-product competitor scanner
# Runs as a separate rotating job so published prices stay fresher than broad discovery.
EBAY_COMPETITOR_SCAN_ENABLED=true
EBAY_COMPETITOR_SCHEDULER_MINUTES=10
EBAY_COMPETITOR_SCAN_MINUTES=60
EBAY_COMPETITOR_PRODUCTS_PER_RUN=40
EBAY_COMPETITOR_DISCOVERY_RESULTS_PER_PRODUCT=100
# V3.7.34: additive discovery searches every available safe signal instead of
# choosing only one identifier. Up to five distinct plans are possible:
# GTIN, ePID, Brand+MPN, MPN-only, and strict title.
EBAY_COMPETITOR_DISCOVERY_SIGNAL_SEARCHES=5
EBAY_COMPETITOR_RESULTS_PER_PRODUCT=50
EBAY_COMPETITOR_RECALL_ENABLED=true
EBAY_COMPETITOR_RECALL_SEARCHES=2
EBAY_COMPETITOR_RECALL_RESULTS=40
EBAY_COMPETITOR_TITLE_MATCH_MIN=0.90
EBAY_COMPETITOR_PENDING_TARGET_PER_PRODUCT=8
EBAY_COMPETITOR_PENDING_SELLER_TARGET=4

# Competitor integrity cleanup
# Runs once synchronously at startup, then once every 24 hours.
EBAY_COMPETITOR_CLEANUP_ENABLED=true
EBAY_COMPETITOR_CLEANUP_HOURS=24
# V3.7.11 retains V3.7.7 cleanup telemetry; these settings control the synchronous trust-cleanup phase.
EBAY_COMPETITOR_CLEANUP_PROGRESS_ENABLED=true
EBAY_COMPETITOR_CLEANUP_PROGRESS_SECONDS=2
EBAY_COMPETITOR_CLEANUP_PROGRESS_ITEMS=250

# V3.7.11 early database startup telemetry. Progress callbacks are emitted every N products
# while rebuilding cached search/offer/Deal Heat/Price Signal intelligence.
DB_STARTUP_PROGRESS_ITEMS=100
STALE_OFFER_DAYS=7
PRICE_HISTORY_DAYS=365
CLICK_LOG_LIMIT=50000

# Legacy v1 discovery settings are still understood.
# On first V2 startup, if you have no saved rules, these are imported as rules.
EBAY_DISCOVERY_QUERIES=aquarium filter|3d printer accessories|mechanic tools
AWIN_DISCOVERY_FEEDS=
# Example: AWIN_DISCOVERY_FEEDS=12345:en_US,67890:en_US

# eBay environment + Marketplace Account Deletion compliance.
# API credentials themselves are listed once in the Admin credential-vault
# fallback section below.
EBAY_ENVIRONMENT=sandbox
EBAY_ACCOUNT_DELETION_ENDPOINT=https://www.offergrid.tech/api/ebay/account-deletion
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=
EBAY_DEV_ID=
EBAY_REDIRECT_URI=
EBAY_DELETION_VERIFY_SIGNATURES=true

# Optional OpenAI enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google AdSense
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Starter-store bootstrap
# On an empty catalog, V3.0 can automatically pull real products from eBay
# as soon as EBAY_CLIENT_ID / EBAY_CLIENT_SECRET are configured.
STARTER_POPULATE_ON_BOOT=true
STARTER_AUTO_PUBLISH=true
STARTER_PRODUCTS_PER_QUERY=10

# ------------------------------------------------------------------
# Admin credential vault
# ------------------------------------------------------------------
# Credentials entered in Admin are encrypted at rest in:
#   data/private-config.json
#
# Set a stable random key BEFORE saving credentials in Admin.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=

# Environment variables remain supported as fallbacks. Values saved
# through Admin override matching environment variables.

# eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_AFFILIATE_CAMPAIGN_ID=
EBAY_AFFILIATE_REFERENCE_ID=offergrid
EBAY_DEFAULT_COMMISSION_RATE=0.03

# Best Buy Developer API
BESTBUY_API_KEY=
BESTBUY_DEFAULT_COMMISSION_RATE=0

# UPCitemdb
# Leave UPCITEMDB_USER_KEY blank to use the free trial endpoint.
UPCITEMDB_USER_KEY=
UPCITEMDB_KEY_TYPE=3scale

# Open Facts family (no API key required for read operations)
OPEN_FACTS_DATASET=openproductsfacts
OPEN_FACTS_APP_NAME=OfferGrid
OPEN_FACTS_CONTACT_EMAIL=

# Awin
AWIN_ACCESS_TOKEN=
AWIN_PUBLISHER_ID=
AWIN_DEFAULT_COMMISSION_RATE=0.05

# Rakuten Advertising
# Every broad discovery search that would query eBay is also mirrored to
# Rakuten Product Search when an access token is configured.
RAKUTEN_SEARCH_ENABLED=true
RAKUTEN_ACCESS_TOKEN=
# Optional but strongly recommended: enables automatic 60-minute token refresh.
RAKUTEN_REFRESH_TOKEN=
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_ACCOUNT_ID=
RAKUTEN_LANGUAGE=en_US
RAKUTEN_SEARCH_CACHE_SECONDS=120
# 650 ms serial pacing stays below Rakuten's documented 100 calls/min ceiling.
RAKUTEN_RATE_MIN_INTERVAL_MS=650
RAKUTEN_SEARCH_TIMEOUT_MS=12000
RAKUTEN_DEFAULT_COMMISSION_RATE=0.05
# Rakuten accepts u1 only for publisher accounts with Signature tracking enabled.
RAKUTEN_SIGNATURE_TRACKING_ENABLED=false

# Rakuten Product Catalog SFTP
# Prefer saving the username/password in Admin -> API connections so they stay
# in OfferGrid's encrypted private-config vault. These .env values are fallbacks.
RAKUTEN_CATALOG_SYNC_ENABLED=true
RAKUTEN_SFTP_HOST=aftp.linksynergy.com
RAKUTEN_SFTP_PORT=22
RAKUTEN_SFTP_USERNAME=
RAKUTEN_SFTP_PASSWORD=
RAKUTEN_SFTP_TIMEOUT_MS=20000
RAKUTEN_CATALOG_AUTO_APPROVE=true
RAKUTEN_CATALOG_SYNC_MINUTES=30
RAKUTEN_CATALOG_FULL_REFRESH_HOURS=24
RAKUTEN_CATALOG_BATCH_SIZE=250
# 0 means process the complete advertiser feed. Non-zero is a diagnostic cap.
RAKUTEN_CATALOG_MAX_PRODUCTS_PER_FILE=0

# Amazon Creators API
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_TOKEN_REGION=NA


# Squirrel automatic affiliate-link monetization
# This script URL is intentionally public because browsers must load it.
SQUIRREL_ENABLED=true
SQUIRREL_SCRIPT_URL=

# Live-domain / reverse-proxy settings
HOST=127.0.0.1
CANONICAL_HOST=
ENFORCE_CANONICAL_HOST=false
FORCE_HTTPS=false
TRUST_PROXY=1
SHOW_ADMIN_NAV=true
STRICT_PRODUCTION=false
CONTACT_EMAIL=
CLOUDFLARE_ACCESS_REQUIRED=false
CLOUDFLARE_ACCESS_EMAILS=

# Accuracy / integrity

# Optional buyer location improves eBay shipping estimates.
# Leave postal code blank rather than guessing a buyer location.
EBAY_BUYER_COUNTRY=US
EBAY_BUYER_POSTAL_CODE=

CATALOG_INTEGRITY_ENABLED=true
CATALOG_INTEGRITY_HOURS=6

# V3.7.30 quota-aware local normalization maintenance
LOCAL_NORMALIZATION_ENABLED=true
LOCAL_NORMALIZATION_HEARTBEAT_MINUTES=10
LOCAL_NORMALIZATION_MINUTES=30
LOCAL_NORMALIZATION_CONSTRAINED_MINUTES=10
LOCAL_NORMALIZATION_PRODUCTS_PER_PASS=2500
LOCAL_NORMALIZATION_CONSTRAINED_BATCH=5000
LOCAL_NORMALIZATION_QUIET_MS=500

# V3.0 TURBO performance
VERBOSE_LOGGING=true
DB_PRETTY_JSON=false

# Catalog page/search worker threads.
CATALOG_SEARCH_THREADS=2

# V3.7.23 async intelligence pipeline — tuned for i7-8700K (6C/12T), 16GB RAM, NVMe.
# 8 Deal Heat workers + 2 catalog-search workers + the Node request thread use
# 11 logical CPUs, leaving one logical CPU for OS/network/libuv headroom.
INTELLIGENCE_WORKERS=8
INTELLIGENCE_PREP_BATCH_SIZE=256
INTELLIGENCE_PREP_QUIET_MS=50
INTELLIGENCE_RESULT_COMMIT_MS=250
INTELLIGENCE_RESULT_COMMIT_BATCH=64
INTELLIGENCE_SNAPSHOT_PERSIST_MS=15000
INTELLIGENCE_STALE_MINUTES=180
INTELLIGENCE_LAZY_SCAN_MINUTES=2
INTELLIGENCE_LAZY_SCAN_BATCH=32

# RAM write-ahead/coalescing window. Runtime offer/product mutations remain live
# in memory immediately; raw best-price observations and the atomic catalog
# snapshot are coalesced before touching NVMe.
MUTATION_BUFFER_WINDOW_MS=120000
MUTATION_BUFFER_MAX_AGE_MS=300000
MUTATION_BUFFER_MAX_PRODUCTS=1024
MUTATION_BUFFER_QUIET_MS=75

# Heavy integrity/lifecycle startup passes run after the HTTP listener is live.
STARTUP_MAINTENANCE_DELAY_MS=30000

# V3.7.24+ confident draft curator. New, untouched drafts are reviewed locally
# and published only when source trust + identity/isolation evidence crosses
# the fail-closed confidence threshold. Manual Hide/Edit locks a draft out.
DRAFT_AUTO_APPROVE_ENABLED=true
DRAFT_AUTO_APPROVE_MINUTES=1
DRAFT_AUTO_APPROVE_BATCH=200
DRAFT_AUTO_APPROVE_MIN_CONFIDENCE=80
DRAFT_AUTO_APPROVE_MAX_AGE_HOURS=168
DRAFT_AUTO_APPROVE_QUIET_MS=250
STORE_PAGE_SIZE=40

# Faster exact-price refresh using eBay getItems batches.
# getItems can verify many item IDs in a single Browse API call.
EBAY_PRICE_VERIFY_ENABLED=true
EBAY_PRICE_VERIFY_MINUTES=10
EBAY_PRICE_VERIFY_OFFERS_PER_RUN=320
EBAY_PRICE_VERIFY_BATCH_SIZE=20
EBAY_PRICE_VERIFY_CONCURRENCY=4
EBAY_LIVE_VERIFY_MAX_AGE_MINUTES=10

# User-driven precision discovery when the relevant local catalog cannot fill the requested page.
LIVE_SEARCH_ENABLED=true
# V3.7.46 first-paint discovery is intentionally tiny and eBay-first. These
# controls are independent from older LIVE_SEARCH_MARKETPLACE_PAGE_SIZE values
# so an existing .env with a large legacy page size cannot recreate the stall.
LIVE_SEARCH_FIRST_PAINT_MARKETPLACE_PAGE_SIZE=30
LIVE_SEARCH_FIRST_PAINT_MAX_PAGES=2
LIVE_SEARCH_FIRST_PAINT_BUDGET_MS=8000
LIVE_SEARCH_FIRST_PAINT_INGEST_LIMIT=20
LIVE_SEARCH_FIRST_PAINT_VERIFY_LIMIT=8
LIVE_SEARCH_FIRST_PAINT_VERIFY_BURST=3
LIVE_SEARCH_FIRST_PAINT_DRAFT_REVIEW_LIMIT=80
LIVE_SEARCH_FIRST_PAINT_DRAFT_VERIFY_LIMIT=6
LIVE_SEARCH_FIRST_PAINT_DRAFT_API_CALLS=1
# After first paint, an underfilled active shopper page keeps expanding in the
# background lane until its requested capacity is reached or the source is
# genuinely exhausted/deferred. Exact source proof stays deliberately bounded.
LIVE_SEARCH_BACKGROUND_PAGE_SIZE=50
LIVE_SEARCH_BACKGROUND_VERIFY_LIMIT=8
LIVE_SEARCH_BACKGROUND_CHAIN_STEPS=8
LIVE_SEARCH_BACKGROUND_STEP_DELAY_MS=500
LIVE_SEARCH_MAX_PAGES_PER_QUERY=8
LIVE_SEARCH_QUERY_VARIANTS=6
LIVE_SEARCH_EXHAUSTED_RETRY_MINUTES=15
# Legacy compatibility knobs retained for older automation/scripts; they no
# longer control the shopper first-paint marketplace request.
LIVE_SEARCH_MARKETPLACE_PAGE_SIZE=50
LIVE_SEARCH_PAGES_PER_INTERACTION=2
# Exact-detail verification remains quota-aware; unverified relevant discoveries are tracked but unpublished.
LIVE_SEARCH_VERIFY_LIMIT=100
# V3.7.25: before new marketplace expansion, review recent untouched drafts that
# strictly match the current shopper query. Foreground eBay verification is
# bounded so real users get visible results without draining the getItems reserve.
LIVE_SEARCH_DRAFT_REVIEW_LIMIT=400
LIVE_SEARCH_DRAFT_VERIFY_LIMIT=120
LIVE_SEARCH_DRAFT_VERIFY_MAX_API_CALLS=6
LIVE_SEARCH_TIMEOUT_MS=20000

# Anonymous visitor-presence heartbeat expires after 7 minutes without a refresh.
VISITOR_ACTIVE_TTL_MS=420000

# V3.7.40: a user-triggered marketplace expansion prepares the entire visible
# catalog page before the completed result is returned. Every visible product
# below the verified-seller target gets an interactive competitor scan attempt.
# There is intentionally no fixed "products per live search" cap anymore.
# Exact identity trust and the shared eBay RateGuard still apply, so a truly
# exhausted/blocked API budget can defer individual products rather than inventing coverage.
LIVE_SEARCH_COMPETITOR_HYDRATE_ENABLED=true
LIVE_SEARCH_COMPETITOR_SIGNALS=5
LIVE_SEARCH_COMPETITOR_EXACT_CANDIDATES=6
LIVE_SEARCH_COMPETITOR_TARGET_SELLERS=3
LIVE_SEARCH_COMPETITOR_CONCURRENCY=1
# Re-query the sorted page after hydration so newly attached offers cannot move
# an unhydrated product onto the final visible page unnoticed.
LIVE_SEARCH_COMPETITOR_PAGE_STABILITY_ROUNDS=3
# Database-backed result pages are considered competitor-hydrated for this long before a foreground rescan is due.
LIVE_SEARCH_COMPETITOR_PAGE_FRESH_MINUTES=60
USER_SEARCH_RULE_LIMIT=120

DISCOVERY_IO_CONCURRENCY=4
EBAY_STARTUP_VERIFY_BURST_RUNS=5
EBAY_STARTUP_VERIFY_BURST_DELAY_MS=8000

EBAY_VARIATION_VERIFY_BATCH_SIZE=10

# V3.3 eBay API rate guard
# Conservative local limits matching eBay's default Production Browse quotas.
# Background automation stops early and preserves a reserve for real users.
EBAY_RATE_GUARD_ENABLED=true
EBAY_BROWSE_DAILY_LIMIT=5000
EBAY_GETITEMS_DAILY_LIMIT=5000
EBAY_RATE_SAFETY_MARGIN=300
EBAY_INTERACTIVE_RESERVE=900
EBAY_RATE_MIN_INTERVAL_MS=180
EBAY_RATE_LIMIT_COOLDOWN_MINUTES=60
EBAY_SEARCH_CACHE_SECONDS=300
EBAY_SEARCH_CACHE_MAX_SECONDS=1800

# Configurable soft-limit stages. Background discovery/refresh work tapers as
# the effective daily budget is consumed; interactive catalog viewing remains
# local and is never blocked by these thresholds.
EBAY_SOFT_LIMIT_START_PCT=70
EBAY_SOFT_LIMIT_STRICT_PCT=85
EBAY_SOFT_LIMIT_CRITICAL_PCT=95
EBAY_SOFT_LIMIT_CONSERVE_MULTIPLIER=0.60
EBAY_SOFT_LIMIT_STRICT_MULTIPLIER=0.25
EBAY_SOFT_LIMIT_CRITICAL_MULTIPLIER=0.05

# 429 handling. Retry-After is authoritative when eBay supplies it. Otherwise
# the guard uses exponential backoff with jitter and avoids retry storms.
EBAY_RATE_BACKOFF_BASE_MS=2000
EBAY_RATE_BACKOFF_MAX_MS=3600000
EBAY_RATE_BACKOFF_JITTER_PCT=0.25

# At most two infrastructure retries, matching eBay Growth Check guidance.
EBAY_INFRA_RETRY_BASE_MS=400
EBAY_INFRA_RETRY_MAX_MS=5000
EBAY_INFRA_RETRY_JITTER_PCT=0.25

# V3.7.37 restricted bulk capability fallback. Some eBay production clients
# can search/getItem but are not entitled to bulk getItems. OfferGrid probes
# bulk access, remembers a 403/1100 denial, and then uses ordinary getItem
# within a bounded share of the Browse quota. These defaults normally need no
# changes.
EBAY_BULK_GETITEMS_RETRY_MINUTES=360
EBAY_GETITEM_FALLBACK_WINDOW_MINUTES=10
EBAY_GETITEM_FALLBACK_BROWSE_SHARE=0.30
# Reserve most fallback calls for competitor identity proof; routine price refresh cannot consume this share.
EBAY_GETITEM_FALLBACK_IDENTITY_RESERVE_SHARE=0.80
EBAY_GETITEM_FALLBACK_MAX_CALLS_PER_WINDOW=40
EBAY_BACKGROUND_GETITEM_FALLBACK_MAX_PER_BATCH=8
EBAY_BACKGROUND_GETITEM_FALLBACK_CONCURRENCY=2
EBAY_INTERACTIVE_GETITEM_FALLBACK_MAX=6
EBAY_INTERACTIVE_GETITEM_FALLBACK_CONCURRENCY=3

# V3.7.38 adaptive verification throughput. When the exact-competitor pending
# queue grows, OfferGrid increases the safe Browse share available to ordinary
# getItem identity proof, throttles new competitor scans, and in catch-up mode
# temporarily suspends routine public-product price refresh. V3.7.39 preserves
# the unreserved price slice for exact verification of draft source listings so
# draft auto-approval does not starve. Interactive reserve and RateGuard hard
# caps remain authoritative.
EBAY_ADAPTIVE_VERIFICATION_ENABLED=true
EBAY_ADAPTIVE_VERIFY_ELEVATED_PENDING=500
EBAY_ADAPTIVE_VERIFY_HIGH_PENDING=1500
EBAY_ADAPTIVE_VERIFY_CATCHUP_PENDING=3000
EBAY_ADAPTIVE_VERIFY_ELEVATED_BROWSE_SHARE=0.50
EBAY_ADAPTIVE_VERIFY_HIGH_BROWSE_SHARE=0.75
EBAY_ADAPTIVE_VERIFY_CATCHUP_BROWSE_SHARE=1.00
EBAY_ADAPTIVE_VERIFY_ELEVATED_MAX_CALLS_PER_WINDOW=18
EBAY_ADAPTIVE_VERIFY_HIGH_MAX_CALLS_PER_WINDOW=26
EBAY_ADAPTIVE_VERIFY_CATCHUP_MAX_CALLS_PER_WINDOW=35
EBAY_ADAPTIVE_VERIFY_ELEVATED_DISCOVERY_SCALE=0.70
EBAY_ADAPTIVE_VERIFY_HIGH_DISCOVERY_SCALE=0.40
EBAY_ADAPTIVE_VERIFY_CATCHUP_DISCOVERY_SCALE=0.15
EBAY_ADAPTIVE_VERIFY_CATCHUP_SUSPEND_PRICE_REFRESH=true

# Avoid converting one omitted bulk item into dozens of getItem calls.
# One-item getItem fallbacks burn Browse quota; keep disabled unless diagnosing omitted IDs.
EBAY_ALLOW_INDIVIDUAL_GETITEM_FALLBACK=false
EBAY_BACKGROUND_MISSING_FALLBACK_MAX=0
EBAY_INTERACTIVE_MISSING_FALLBACK_MAX=0

# V3.4 self-cleaning product lifecycle
PRODUCT_LIFECYCLE_ENABLED=true
PRODUCT_LIFECYCLE_HOURS=24

# 120 days sits inside the requested 90–180 day dormant window.
PRODUCT_DORMANT_DAYS=120
PRODUCT_STALE_DAYS=365
PRODUCT_PRUNABLE_DAYS=365

# PRUNABLE means eligible after a year; this grace keeps it visible to the
# lifecycle system before the expensive/raw record is archived.
PRODUCT_PRUNE_GRACE_DAYS=30

# Products with durable identity/history/traffic can retain richer data longer.
PRODUCT_PROTECTED_RETENTION_DAYS=730
PRODUCT_LIFECYCLE_CLICK_PROTECTION_THRESHOLD=5
PRODUCT_LIFECYCLE_HISTORY_PROTECTION_SAMPLES=12

# Low-frequency marketplace revival probes.
PRODUCT_DORMANT_REFRESH_DAYS=7
PRODUCT_STALE_REFRESH_DAYS=30

# Price-history compaction.
PRICE_HISTORY_RAW_DAYS=90
PRICE_HISTORY_WEEKLY_DAYS=365
PRICE_AGGREGATE_RETENTION_DAYS=3650
PRICE_COMPRESSION_HOURS=12

# V3.7.2: if eBay rejects a syntactically valid product identifier with Browse
# error 12001, do not waste one failed exact-search call on every future scan.
EBAY_EXACT_SEARCH_QUARANTINE_DAYS=30

# V3.7.3 authoritative eBay quota synchronization
EBAY_ANALYTICS_SYNC_ENABLED=true
EBAY_ANALYTICS_SYNC_MINUTES=30
EBAY_ANALYTICS_CACHE_MINUTES=15

# If eBay returns hard ACCESS/2001 resource exhaustion without a Retry-After
# or usable Developer Analytics reset, pause conservatively instead of retrying
# every hour.
EBAY_RESOURCE_LIMIT_COOLDOWN_HOURS=24

# V3.7.4 fail-closed competitor proof. Candidate listings are fetched through
# eBay getItems and must prove the same exact machine identity before attach.
EBAY_COMPETITOR_EXACT_BATCH_SIZE=20

# V3.7.6 retains the V3.7.5 bulk competitor sanitizer + API-efficiency controls.
# Unproven legacy competitors are hidden immediately, then verified in getItems
# batches. Scheduled workers spread safe background quota across the reset window.
EBAY_COMPETITOR_SANITIZER_ENABLED=true
EBAY_COMPETITOR_SANITIZER_MINUTES=5
EBAY_COMPETITOR_SANITIZER_MAX_CALLS_PER_RUN=40
EBAY_COMPETITOR_SANITIZER_QUOTA_SHARE=0.45
EBAY_COMPETITOR_SANITIZER_RETRY_MINUTES=60

# Reuse exact getItems details briefly across scanner/verifier/sanitizer workers.
# Interactive stale checks still only accept data within their freshness window.
EBAY_ITEM_DETAIL_CACHE_SECONDS=300

# Product identity metadata is stable and can be reused much longer than live
# price/availability data. This cache is used only for identity lookups.
EBAY_ITEM_IDENTITY_CACHE_SECONDS=86400

# Persistent endpoint usage metrics retained for Growth Check planning.
EBAY_USAGE_DAY_RETENTION_DAYS=45
EBAY_USAGE_HOUR_RETENTION_HOURS=1080
EBAY_USAGE_PERSIST_DEBOUNCE_MS=5000
EBAY_USAGE_DEFERRED_KEY_CAP=25000
# V3.7.27 quota-growth telemetry. Shadow demand records unique API work that
# OfferGrid could not execute because the local/authoritative eBay quota guard
# withheld it. The recommendation adds 50% headroom and rounds to 500 calls.
EBAY_QUOTA_REQUEST_HEADROOM_MULTIPLIER=1.50
EBAY_QUOTA_REQUEST_ROUND_TO=500
EBAY_SHADOW_DEMAND_MAX_ITEMS_PER_PASS=5000

# Spread each background workload over the available quota window instead of
# allowing one worker to drain a whole daily allowance early.
EBAY_DISCOVERY_QUOTA_SHARE=0.30
EBAY_DISCOVERY_MAX_CALLS_PER_CYCLE=24
EBAY_COMPETITOR_SCAN_QUOTA_SHARE=0.25
EBAY_COMPETITOR_DISCOVERY_QUOTA_SHARE=0.55

# Give scheduled price refresh its own quota-aware share instead of allowing it
# to consume the whole safe background getItems allowance early in the day.
EBAY_PRICE_VERIFY_QUOTA_SHARE=0.45
EBAY_PRICE_VERIFY_MAX_CALLS_PER_RUN=30
# Startup console progress (tqdm-style)
STARTUP_TQDM=true
STARTUP_TQDM_MIN_INTERVAL_MS=100
# Set true for plain ASCII bars or to force bars in non-TTY log collectors.
STARTUP_TQDM_ASCII=false
STARTUP_TQDM_FORCE=false


# V3.7.15 interactive-priority responsiveness diagnostics
EVENT_LOOP_WATCHDOG_ENABLED=true
EVENT_LOOP_WATCHDOG_INTERVAL_MS=1000
EVENT_LOOP_STALL_WARN_MS=1000


# V3.7.15 interactive-priority responsiveness
# Shopper/admin HTTP requests outrank scheduled verification, discovery, and maintenance.
INTERACTIVE_PRIORITY_ENABLED=true
INTERACTIVE_PRIORITY_GRACE_MS=175
INTERACTIVE_PRIORITY_POLL_MS=12
HEAVY_BACKGROUND_QUIET_MS=2000
# Clicks redirect immediately; eBay revalidation happens after the response.
EBAY_OUTBOUND_REVALIDATE_MINUTES=5
# Catalog snapshots wait for a quiet window. Outbound clicks use an append-only ledger.
DEFERRED_WRITE_QUIET_MS=500

# V3.7.15 foreground-latency tuning
INTERACTIVE_BACKGROUND_APPLY_CHUNK=40
INTERACTIVE_SLOW_REQUEST_MS=500
RUNTIME_PERSIST_DELAY_MS=1000

# V3.7.27 shopper-safe fallback for relevant eBay drafts while exact getItems verification is unavailable.
PENDING_VERIFICATION_FALLBACK_ENABLED=true
PENDING_VERIFICATION_MIN_CONFIDENCE=70
PENDING_VERIFICATION_MAX_AGE_HOURS=72

# V3.7.32 catalog boundary hardening. If catalog.json is missing or unreadable
# after an interrupted atomic write, OfferGrid may recover a structurally valid
# completed catalog.json.tmp instead of booting an empty catalog.
DB_RECOVER_VALID_TEMP=true
# Optional stronger disk-durability barrier. Leave false for current latency
# behavior; enable only if the host/storage benefits from explicit fsync.
DB_FSYNC_WRITES=false
